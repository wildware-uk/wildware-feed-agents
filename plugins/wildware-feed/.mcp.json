{
	"mcpServers": {
		"agent-dashboard": {
			"type": "http",
			"url": "${user_config.dashboard_url}/mcp",
			"headersHelper": "node \"${CLAUDE_PLUGIN_ROOT}/bin/feed.mjs\" headers --data \"${CLAUDE_PLUGIN_DATA}\" --project \"${CLAUDE_PROJECT_DIR}\""
		},
		"agent-dashboard-channel": {
			"command": "node",
			"args": ["${CLAUDE_PLUGIN_ROOT}/bin/channel.mjs", "--data", "${CLAUDE_PLUGIN_DATA}"],
			"env": {
				"AGENT_DASHBOARD_URL": "${user_config.dashboard_url}"
			}
		}
	}
}
